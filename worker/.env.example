# Copy to .env (or set as environment variables). All are optional.
CLEANSHOT_HOST=0.0.0.0
CLEANSHOT_PORT=8000
# Shared secret; when set, the app must send the same value (Settings → API key).
CLEANSHOT_API_KEY=
CLEANSHOT_CORS_ORIGINS=["*"]
CLEANSHOT_DATA_DIR=./data
CLEANSHOT_MAX_UPLOAD_MB=25
CLEANSHOT_MAX_IMAGES_PER_BATCH=50
CLEANSHOT_MAX_INPUT_SIDE=4096
CLEANSHOT_WORKER_CONCURRENCY=2
CLEANSHOT_BATCH_TTL_HOURS=72
CLEANSHOT_WARMUP_MODELS=["u2netp"]
# Generated scenes: auto | diffusion | procedural
CLEANSHOT_SCENE_BACKEND=auto
CLEANSHOT_SCENE_MODEL=stabilityai/sd-turbo
CLEANSHOT_SCENE_STEPS=2
CLEANSHOT_SCENE_DEVICE=auto
CLEANSHOT_LOG_LEVEL=INFO
